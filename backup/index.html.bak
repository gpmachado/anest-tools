    <span class="icon">💨</span>Volátil
  </button>
</nav>

<script src="js/infusion.js"></script>
<script>
/* ── utils ── */
const W   = () => parseFloat(document.getElementById('weight').value) || 0;
const H   = () => parseFloat(document.getElementById('height').value) || 0;
const f   = (n, d=1) => (isNaN(n)||!isFinite(n)||n<=0) ? '—' : (+n.toFixed(d)).toString();

let modes = {};
let sex = 'M'; // 'M' | 'F'
let weights = { tbw:0, ibw:0, abw:0, lbw:0 }; // updated in update()

function setSex(s) {
  sex = s;
  document.getElementById('sexM').classList.toggle('active', s==='M');
  document.getElementById('sexF').classList.toggle('active', s==='F');
  update();
}

function nav(id, el) {
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tab-'+id).classList.add('active');
  if (id === 'vol') setTimeout(volCalc, 50);
}

function toggleMode(drugId, mode) {
  modes[drugId] = mode;
  update();
}

/* ── Weight formulas ── */
function calcIBW(h_cm, s) {
  // Devine: ♂ 50 + 0.91×(h−152.4) | ♀ 45.5 + 0.91×(h−152.4)
  if (!h_cm || h_cm < 100) return 0;
  const base = s === 'F' ? 45.5 : 50;
  return Math.max(base + 0.91 * (h_cm - 152.4), 30);
}

function calcLBW(w, h_cm, s) {
  // Janmahasatian 2005 (James cai com IMC alto e subdosava obesos)
  if (!w || !h_cm) return 0;
  const imc = w / (h_cm/100)**2;
  return s === 'F' ? 9270*w / (8780 + 244*imc) : 9270*w / (6680 + 216*imc);
}

function calcABW(tbw, ibw) {
  // ABW = IBW + 0.4×(TBW − IBW)  [Bauer et al.]
  if (!tbw || !ibw) return 0;
  if (tbw <= ibw) return ibw; // não obeso — usa IBW
  return ibw + 0.4 * (tbw - ibw);
}

/* peso por tipo */
function wByType(type) {
  const t = weights.tbw;
  switch(type) {
    case 'IBW': return Math.min(weights.ibw || t, t);
    case 'LBW': return Math.min(weights.lbw || weights.ibw || t, t);
    default:    return t; // TBW
  }
}

const wTypeColor = { TBW:'var(--text)', IBW:'var(--green)', ABW:'var(--orange)', LBW:'var(--purple)' };

function update() {
  const w = W(), h = H();

  // IMC
  const imcEl = document.getElementById('imc-display');
  if (w && h) {
    const hm = h/100, imc = w/(hm*hm);
    let cls, label;
    if      (imc < 18.5) { cls='imc-low';    label='Baixo peso'; }
    else if (imc < 25)   { cls='imc-normal';  label='Normal'; }
    else if (imc < 30)   { cls='imc-over';    label='Sobrepeso'; }
    else if (imc < 35)   { cls='imc-obese';   label='Obesidade I'; }
    else if (imc < 40)   { cls='imc-obese';   label='Obesidade II'; }
    else                 { cls='imc-mobese';  label='Ob. Mórbida'; }
    imcEl.innerHTML = `<span class="imc-val">${f(imc,1)}</span><span class="imc-label ${cls}">${label}</span>`;
  } else {
    imcEl.innerHTML = `<span style="color:var(--muted);font-size:0.78rem;font-weight:500">—</span>`;
  }

  // Compute weights
  const ibw = calcIBW(h, sex);
  const lbw = calcLBW(w, h, sex);
  const abw = calcABW(w, ibw);
  weights = { tbw: w, ibw, abw, lbw };

  // Display weight boxes
  const kg = v => v ? `${f(v,1)}<span class="wbox-unit"> kg</span>` : `<span style="color:var(--muted);font-size:0.75rem">—</span>`;
  document.getElementById('w-tbw').innerHTML = kg(w);
  document.getElementById('w-ibw').innerHTML = kg(ibw);
  // ABW only meaningful if obese (TBW > IBW * 1.2)
  const showAbw = w && ibw && w > ibw * 1.1;
  document.getElementById('w-abw').innerHTML = showAbw ? kg(abw) : `<span style="color:var(--muted);font-size:0.72rem">= IBW</span>`;
  document.getElementById('w-lbw').innerHTML = kg(lbw);

  renderIOT();
  renderSed();
  renderAdj();
  renderAL();
  renderVaso();
  renderHid();
  renderLab();
  renderPCR();
  if (typeof renderInfusion === 'function') renderInfusion();
  if (document.getElementById('tab-vol').classList.contains('active')) volCalc();
}

function noWeight() {
  return `<div class="no-weight"><div class="icon">⚖️</div>Insira o peso do paciente para calcular.</div>`;
}

/* ════════════════════════════════════════
   IOT / Indução
════════════════════════════════════════ */
function renderIOT() {
  const el = document.getElementById('tab-iot');
  if (!W()) { el.innerHTML = `<div class="disclaimer">⚠️ Uso exclusivo por médico. Valores de referência.</div>` + noWeight(); return; }

  // Each drug picks its own weight via wByType
  const mk = (wtype) => wByType(wtype);

  const drugs = [
    (() => { const wt = mk('LBW'); return {
      id:'fen', wtype:'LBW', name:'Fentanil', color:'var(--purple)',
      sub:'Opioide — analgesia pré-IOT', conc:'50 mcg/ml (amp 2ml)', hasModes:true,
      iotRows:[
        { l:'Pré-IOT  1 mcg/kg', v:`${f(wt*1/50)} ml`, u:`= ${f(wt*1)} mcg` },
        { l:'Dose máx  3 mcg/kg', v:`${f(wt*3/50)} ml`, u:`= ${f(wt*3)} mcg` },
      ],
      iotNote:`Ampola 2ml = 100 mcg | Usar sem diluição`,
      infTable: infTable_wt(wt, [
        {d:0.5, eff:'Analgesia leve', conc_mcg_ml:5, unit:'mcg/kg/h'},
        {d:1,   eff:'Analgesia mod.', conc_mcg_ml:5, unit:'mcg/kg/h'},
        {d:2,   eff:'Sedação profunda', conc_mcg_ml:5, unit:'mcg/kg/h'},
      ], 'mcg/kg/h'),
      infNote:`Diluição: 5 amp (500mcg) + 90ml SF → <strong>5 mcg/ml</strong> | Faixa típica: 25–200 mcg/h`,
      badges:[{t:'Analgesia',c:'bg'},{t:'Depressão resp.',c:'br'}],
    }})(),
    (() => { const wt = mk('TBW'); return {
      id:'eto', wtype:'TBW', name:'Etomidato', color:'var(--green)',
      sub:'Hipnótico — melhor estabilidade HD', conc:'2 mg/ml (amp 10ml)', hasModes:false,
      iotRows:[{l:'Dose  0,3 mg/kg', v:`${f(wt*0.3/2)} ml`, u:`= ${f(wt*0.3)} mg`}],
      iotNote:`Ampola 10ml = 20mg | Sem diluição`,
      badges:[{t:'↓Hipotensão',c:'bg'},{t:'CI: sepse (suprime adrenal)',c:'bw'}],
    }})(),
    (() => { const wt = mk('TBW'); return {
      id:'cet', wtype:'TBW', name:'Cetamina', color:'var(--yellow)',
      sub:'Dissociativo — broncodilatador, estável HD', conc:'50 mg/ml (amp 2ml)', hasModes:false,
      iotRows:[
        {l:'Mín  1 mg/kg', v:`${f(wt*1/50)} ml`, u:`= ${f(wt*1)} mg`},
        {l:'Máx  2 mg/kg', v:`${f(wt*2/50)} ml`, u:`= ${f(wt*2)} mg`},
      ],
      iotNote:`Pode diluir: 2ml + 8ml SF → 10mg/ml<br>Diluído: 1mg/kg = <strong>${f(wt/10)} ml</strong> | 2mg/kg = <strong>${f(wt*2/10)} ml</strong><br>Infusão → aba Sedação`,
      badges:[{t:'Sepse/instabilidade HD',c:'bg'},{t:'Broncoespasmo',c:'bg'},{t:'CI relativa: HIC, HAS',c:'bw'}],
    }})(),
    (() => { const wt = mk('IBW'); return {
      id:'mid', wtype:'IBW', name:'Midazolam', color:'var(--accent)',
      sub:'Benzodiazepínico — amnésia anterógrada', conc:'5 mg/ml (amp 3ml)', hasModes:false,
      iotRows:[
        {l:'0,1 mg/kg', v:`${f(wt*0.1/5)} ml`, u:`= ${f(wt*0.1)} mg`},
        {l:'0,2 mg/kg', v:`${f(wt*0.2/5)} ml`, u:`= ${f(wt*0.2)} mg`},
        {l:'0,3 mg/kg', v:`${f(wt*0.3/5)} ml`, u:`= ${f(wt*0.3)} mg`},
      ],
      iotNote:`Sem diluição | Pode diluir 3ml + 7ml SF → 1,5mg/ml`,
      badges:[{t:'Amnésia dose-dependente',c:'bg'},{t:'Hipotensão',c:'bw'},{t:'Reduzir em idosos',c:'bw'}],
    }})(),
    (() => { const wt = mk('LBW'); return {
      id:'pro', wtype:'LBW', name:'Propofol', color:'var(--red)',
      sub:'Hipnótico — broncodilatador', conc:'10 mg/ml (frasco)', hasModes:false,
      iotRows:[
        {l:'Mín  1,5 mg/kg', v:`${f(wt*1.5/10)} ml`, u:`= ${f(wt*1.5)} mg`},
        {l:'Máx  3,0 mg/kg', v:`${f(wt*3/10)} ml`, u:`= ${f(wt*3)} mg`},
      ],
      iotNote:`Frasco 10mg/ml | Sem diluição | Infusão → aba Sedação`,
      badges:[{t:'Broncodilatador',c:'bg'},{t:'Hipotensão importante',c:'br'}],
    }})(),
    (() => { const wt = mk('IBW'); return {
      id:'roc', wtype:'IBW', name:'Rocurônio', color:'var(--green)',
      sub:'BNM não-despolarizante — duração longa', conc:'10 mg/ml (amp 5ml)', hasModes:false,
      iotRows:[
        {l:'IOT  1 mg/kg', v:`${f(wt*1/10)} ml`, u:`= ${f(wt*1)} mg`},
        {l:'RSI  1,2 mg/kg', v:`${f(wt*1.2/10)} ml`, u:`= ${f(wt*1.2)} mg`},
        {l:'Sugamadex reversão rápida  16 mg/kg', v:`${f(wt*16/100)} ml`, u:`= ${f(wt*16)} mg (200mg/2ml)`},
      ],
      iotNote:`Sem diluição | Início: 45-60s | Duração: ~45min`,
      badges:[{t:'Revertível: Sugamadex',c:'bg'},{t:'Duração 45min',c:'bw'}],
    }})(),
    (() => { const wt = mk('TBW'); return {
      id:'sux', wtype:'TBW', name:'Succinilcolina', color:'var(--orange)',
      sub:'BNM despolarizante — duração curta', conc:'10 mg/ml', hasModes:false,
      iotRows:[{l:'Dose  1,5 mg/kg', v:`${f(wt*1.5/10)} ml`, u:`= ${f(wt*1.5)} mg`}],
      iotNote:`Sem diluição | Início: 45-60s | Duração: 6-10min`,
      badges:[{t:'↓Duração',c:'bg'},{t:'CI: hipercalemia',c:'br'},{t:'CI: rabdomiólise, miastenia',c:'br'},{t:'Preferir Roc se CI',c:'bw'}],
    }})(),
  ];

  let html = `<div class="disclaimer">⚠️ Uso exclusivo por médico habilitado. Valores de referência.</div>`;
  html += `<div class="sec-hdr">Hipnóticos / Indução</div>`;
  for (const d of drugs.slice(0,4)) html += buildCard(d);
  html += `<div class="sec-hdr">Bloqueadores Neuromusculares</div>`;
  for (const d of drugs.slice(4)) html += buildCard(d);
  el.innerHTML = html;
}

/* ════════════════════════════════════════
   Sedação Contínua
════════════════════════════════════════ */
function renderSed() {
  const el = document.getElementById('tab-sed');
  if (!W()) { el.innerHTML = noWeight(); return; }

  const drugs = [
    (() => { const wt = wByType('IBW'); return {
      id:'dex', wtype:'IBW', name:'Dexmedetomidina', color:'var(--teal)',
      sub:'α2-agonista — sedação cooperativa', conc:'4 mcg/ml (após diluição)', hasModes:false,
      iotRows:[],
      iotNote:`Amp 200mcg/2ml → 2ml + 48ml SF = <strong>4 mcg/ml (50ml)</strong><br>
      Ataque (opcional): 0,5–1 mcg/kg em 10–20min = <strong>${f(wt*0.5/4,2)}–${f(wt/4,2)} ml (4mcg/ml)</strong>`,
      infTable: infTable_wt(wt,[
        {d:0.2,eff:'Mín sedação',conc_mcg_ml:4,unit:'mcg/kg/h'},
        {d:0.4,eff:'Sedação leve',conc_mcg_ml:4,unit:'mcg/kg/h'},
        {d:0.7,eff:'Sedação mod.',conc_mcg_ml:4,unit:'mcg/kg/h'},
        {d:1.0,eff:'Sedação prof.',conc_mcg_ml:4,unit:'mcg/kg/h'},
        {d:1.4,eff:'Dose máx',conc_mcg_ml:4,unit:'mcg/kg/h'},
      ],'mcg/kg/h'),
      badges:[{t:'Sedação cooperativa',c:'bg'},{t:'Sem depressão resp.',c:'bg'},{t:'Bradicardia/hipotensão',c:'bw'}],
    }})(),
    (() => { const wt = wByType('LBW'); return {
      id:'prop_inf', wtype:'LBW', name:'Propofol', color:'var(--red)',
      sub:'Hipnótico contínuo — UTI/anestesia', conc:'10 mg/ml (frasco)', hasModes:false,
      iotRows:[],
      iotNote:`Frasco 10mg/ml | Sem diluição | Faixa: 0,5–4 mg/kg/h<br><strong>⚠️ Síndrome propofol se &gt;4mg/kg/h por &gt;48h</strong>`,
      infTable: infTable_wt(wt,[
        {d:0.5,eff:'Sedação leve',conc_mcg_ml:10,unit:'mg/kg/h'},
        {d:1.0,eff:'Sedação mod.',conc_mcg_ml:10,unit:'mg/kg/h'},
        {d:2.0,eff:'Sedação prof.',conc_mcg_ml:10,unit:'mg/kg/h'},
        {d:3.0,eff:'Anestesia',conc_mcg_ml:10,unit:'mg/kg/h'},
        {d:4.0,eff:'Dose máx',conc_mcg_ml:10,unit:'mg/kg/h'},
      ],'mg/kg/h'),
      badges:[{t:'Sem diluição',c:'bi'},{t:'CI síndrome propofol',c:'br'}],
    }})(),
    (() => { const wt = wByType('IBW'); return {
      id:'mid_inf', wtype:'IBW', name:'Midazolam', color:'var(--accent)',
      sub:'Benzodiazepínico infusão contínua', conc:'1 mg/ml (após diluição)', hasModes:false,
      iotRows:[],
      iotNote:`Diluição: 15mg (3ml de 5mg/ml) + 12ml SF → <strong>1mg/ml</strong> | Faixa: 0,02–0,1 mg/kg/h`,
      infTable: infTable_wt(wt,[
        {d:0.02,eff:'Sedação mín',conc_mcg_ml:1,unit:'mg/kg/h'},
        {d:0.05,eff:'Sedação mod.',conc_mcg_ml:1,unit:'mg/kg/h'},
        {d:0.07,eff:'Sedação prof.',conc_mcg_ml:1,unit:'mg/kg/h'},
        {d:0.10,eff:'Dose máx',conc_mcg_ml:1,unit:'mg/kg/h'},
      ],'mg/kg/h'),
      badges:[{t:'Acúmulo insuf. renal/hepática',c:'bw'}],
    }})(),
    (() => { const wt = wByType('LBW'); return {
      id:'fen_inf', wtype:'LBW', name:'Fentanil', color:'var(--purple)',
      sub:'Opioide infusão — analgesia contínua', conc:'5 mcg/ml (após diluição)', hasModes:false,
      iotRows:[],
      iotNote:`Diluição: 5 amp (500mcg) + 90ml SF → <strong>5 mcg/ml</strong> | Faixa: 25–200 mcg/h`,
      infTable: (() => {
        const rows = [[25,'Leve'],[50,'Mod.'],[100,'Analgesia'],[150,'Intens.'],[200,'Máx']];
        let t = `<div class="dose-table"><table class="inf-table"><tr><th>mcg/h</th><th>Efeito</th><th>ml/h</th></tr>`;
        rows.forEach(([d,eff]) => { t += `<tr><td>${d}</td><td class="muted">${eff}</td><td class="hl">${f(d/5,1)}</td></tr>`; });
        return t + `</table></div>`;
      })(),
      badges:[{t:'Titular pela dor',c:'bi'},{t:'Depressão resp.',c:'br'}],
    }})(),
    (() => { const wt = wByType('TBW'); return {
      id:'cet_inf', wtype:'TBW', name:'Cetamina', color:'var(--yellow)',
      sub:'Analgesia/sedação dissociativa contínua', conc:'10 mg/ml (após diluição)', hasModes:false,
      iotRows:[],
      iotNote:`Diluição: 2ml (100mg) + 8ml SF → <strong>10mg/ml</strong>`,
      infTable: infTable_wt(wt,[
        {d:0.1,eff:'Analgesia mín',conc_mcg_ml:10,unit:'mg/kg/h'},
        {d:0.3,eff:'Analgesia mod.',conc_mcg_ml:10,unit:'mg/kg/h'},
        {d:0.5,eff:'Analgesia máx',conc_mcg_ml:10,unit:'mg/kg/h'},
        {d:1.0,eff:'Sedação leve',conc_mcg_ml:10,unit:'mg/kg/h'},
        {d:2.0,eff:'Sedação profunda',conc_mcg_ml:10,unit:'mg/kg/h'},
      ],'mg/kg/h'),
      badges:[{t:'Broncoespasmo',c:'bg'},{t:'Boa HD',c:'bg'}],
    }})(),
  ];

  let html = `<div class="sec-hdr">Sedação / Analgesia Contínua</div>`;
  for (const d of drugs) html += buildCard(d);
  el.innerHTML = html;
}

/* Apfel — risco NVPO (Apfel 1999; consenso Gan 2020) */
let apfel = { smoker:false, hist:false, opioid:false };
const APFEL_RISK = [10, 21, 39, 61, 79];
function apfelCard() {
  const n = (sex === 'F') + !apfel.smoker + apfel.hist + apfel.opioid;
  const rec = n === 0 ? 'Sem profilaxia de rotina' : n <= 2 ? '2 antieméticos (ex: dexametasona + ondansetrona)' : '3–4 antieméticos + considerar TIVA';
  const cb = (k, label) => `<label class="score-row"><input type="checkbox" ${apfel[k]?'checked':''} onchange="apfel.${k}=this.checked;renderAdj()"> ${label}</label>`;
  return `<div class="drug-card"><div class="drug-header"><div>
      <div class="drug-name" style="color:var(--teal)">Escore de Apfel</div>
      <div class="drug-subtitle">Risco de náusea e vômito pós-operatório</div></div>
      <div class="drug-conc">${n} pts · ${APFEL_RISK[n]}%</div></div>
    <div class="dose-table">
      <div class="score-row">${sex==='F'?'☑':'☐'} Sexo feminino <span class="dose-unit">(do painel)</span></div>
      ${cb('smoker','Fumante (não fumante pontua)')}
      ${cb('hist','História de NVPO ou cinetose')}
      ${cb('opioid','Opioide no pós-operatório')}
    </div>
    <div class="dilution-note"><strong>${rec}</strong></div></div>`;
}

/* ════════════════════════════════════════
   Adjuvantes
════════════════════════════════════════ */
function renderAdj() {
  const el = document.getElementById('tab-adj');
  if (!W()) { el.innerHTML = noWeight(); return; }

  const secs = [
    {
      hdr: 'Reversão de Bloqueio Neuromuscular',
      drugs: [
        (() => { const wt = wByType('TBW'); return {
          id:'atro', wtype:'TBW', name:'Atropina', color:'var(--orange)',
          sub:'Anticolinérgico — bradicardia / pré-BNM', conc:'0,5 mg/ml (amp 1ml)', hasModes:false,
          iotRows:[
            {l:'Bradicardia  0,01–0,02 mg/kg', v:`${f(wt*0.01/0.5,2)}–${f(wt*0.02/0.5,2)} ml`, u:`= ${f(wt*0.01,3)}–${f(wt*0.02,3)} mg`},
            {l:'Dose fixa mín adulto', v:'1 ml', u:'= 0,5 mg'},
            {l:'Dose máx adulto', v:'6 ml', u:'= 3 mg total'},
          ],
          iotNote:`Ampola 0,5mg/ml | Mín efetiva ≥ 0,5mg (abaixo: bradicardia paradoxal)<br>Dar <strong>antes</strong> da neostigmina`,
          badges:[{t:'Mín 0,5mg',c:'bw'},{t:'Máx 3mg',c:'bw'},{t:'Bradicardia paradoxal <0,5mg',c:'br'}],
        }})(),
        (() => { const wt = wByType('IBW'); return {
          id:'neo', wtype:'IBW', name:'Neostigmina (Prostigmine)', color:'var(--teal)',
          sub:'Anticolinesterásico — reversão BNM', conc:'0,5 mg/ml (amp 1ml)', hasModes:false,
          iotRows:[
            {l:'Dose mín  0,04 mg/kg', v:`${f(wt*0.04/0.5,2)} ml`, u:`= ${f(wt*0.04,2)} mg`},
            {l:'Dose máx  0,07 mg/kg', v:`${f(wt*0.07/0.5,2)} ml`, u:`= ${f(wt*0.07,2)} mg`},
            {l:'Dose máx absoluta', v:'10 ml', u:'= 5 mg'},
          ],
          iotNote:`<strong>Sempre + Atropina 0,015mg/kg:</strong> ${f(wt*0.015/0.5,2)} ml (0,5mg/ml)<br>Só com TOF 4 com fadiga (ASA 2023) — TOF &lt;4: preferir Sugamadex`,
          badges:[{t:'Sempre + Atropina',c:'br'},{t:'TOF ≥2',c:'bw'},{t:'Máx 5mg',c:'bw'}],
        }})(),
        (() => { const wt = wByType('IBW'); return {
          id:'sug', wtype:'IBW', name:'Sugamadex', color:'var(--green)',
          sub:'Reversão seletiva Rocurônio / Vecurônio', conc:'200 mg/2ml (amp)', hasModes:false,
          iotRows:[
            {l:'Rotina — TOF ≥ 2  (2 mg/kg)', v:`${f(wt*2/100,1)} ml`, u:`= ${f(wt*2,0)} mg`},
            {l:'Profundo — TOF 0–1  (4 mg/kg)', v:`${f(wt*4/100,1)} ml`, u:`= ${f(wt*4,0)} mg`},
            {l:'Imediata RSI  (16 mg/kg)', v:`${f(wt*16/100,1)} ml`, u:`= ${f(wt*16,0)} mg`},
          ],
          iotNote:`100mg/ml | Bolus EV rápido | Sem diluição<br><strong>Reversão imediata: 3min após Roc 1,2mg/kg</strong>`,
          badges:[{t:'Específico Roc/Vec',c:'bi'},{t:'Dose por IBW',c:'bi'},{t:'TOF guia dose',c:'bw'}],
        }})(),
      ],
    },
    {
      hdr: 'Analgésicos — Opioides',
      drugs: [
        (() => { const wt = wByType('LBW'); return {
          id:'mor', wtype:'LBW', name:'Morfina', color:'var(--purple)',
          sub:'Opioide forte — analgesia moderada/intensa', conc:'10 mg/ml (amp 1ml)', hasModes:true,
          iotRows:[
            {l:'Bolus mín  0,05 mg/kg', v:`${f(wt*0.05/10,3)} ml`, u:`= ${f(wt*0.05,2)} mg`},
            {l:'Bolus máx  0,1 mg/kg', v:`${f(wt*0.1/10,3)} ml`, u:`= ${f(wt*0.1,2)} mg`},
          ],
          iotNote:`Amp 10mg/ml | Diluir para 1mg/ml (1ml + 9ml SF) → ${f(wt*0.1,2)} ml (0,1mg/kg)<br>Administrar lento IV em 5min — histamina se rápido`,
          infTable: infTable_wt(wt,[
            {d:0.01,eff:'Analgesia leve',conc_mcg_ml:1,unit:'mg/kg/h'},
            {d:0.02,eff:'Analgesia mod.',conc_mcg_ml:1,unit:'mg/kg/h'},
            {d:0.04,eff:'Analgesia intensa',conc_mcg_ml:1,unit:'mg/kg/h'},
          ],'mg/kg/h'),
          infNote:`Diluição infusão: 10mg (1ml) + 9ml SF → <strong>1mg/ml</strong>`,
          badges:[{t:'Analgesia intensa',c:'bg'},{t:'Histamina se rápido',c:'bw'},{t:'Acúmulo insuf. renal',c:'br'},{t:'Naloxona reverte',c:'bi'}],
        }})(),
        (() => { const wt = wByType('TBW'); return {
          id:'tra', wtype:'TBW', name:'Tramadol', color:'var(--accent)',
          sub:'Opioide fraco / misto — analgesia leve-moderada', conc:'50 mg/ml (amp 2ml = 100mg)', hasModes:false,
          iotRows:[
            {l:'Dose mín  1 mg/kg', v:`${f(Math.min(wt*1,100)/50,2)} ml`, u:`= ${f(Math.min(wt*1,100),0)} mg`},
            {l:'Dose máx  2 mg/kg', v:`${f(Math.min(wt*2,100)/50,2)} ml`, u:`= ${f(Math.min(wt*2,100),0)} mg (máx 100mg)`},
          ],
          iotNote:`Amp 50mg/ml (2ml = 100mg) | <strong>Diluir em 100ml SF — infundir em 30min</strong><br>Máximo 400mg/dia | Intervalo 6h`,
          badges:[{t:'Máx 100mg/dose',c:'bi'},{t:'Máx 400mg/dia',c:'bi'},{t:'Infundir lento',c:'bw'},{t:'Abaixa limiar convulsão',c:'br'}],
        }})(),
      ],
    },
    {
      hdr: 'Analgésicos — Não Opioides',
      drugs: [
        (() => { const wt = wByType('TBW'); return {
          id:'para', wtype:'TBW', name:'Paracetamol EV', color:'var(--green)',
          sub:'Analgésico / antipirético — 1ª linha pós-op', conc:'10 mg/ml (frasco 100ml = 1g)', hasModes:false,
          iotRows:[
            {l:'Dose  15 mg/kg', v:`${f(Math.min(wt*15,1000)/10,1)} ml`, u:`= ${f(Math.min(wt*15,1000),0)} mg`},
            {l:'Dose padrão adulto', v:'100 ml', u:'= 1g (máx por dose)'},
          ],
          iotNote:`Frasco pronto 10mg/ml | <strong>Infundir em 15min</strong><br>
          Máx 4g/dia | Intervalo ≥ 4h | Reduzir a 2g/dia em hepatopatas`,
          badges:[{t:'Infundir 15min',c:'bw'},{t:'Máx 1g/dose',c:'bi'},{t:'CI: hepatopatia grave',c:'br'}],
        }})(),
        (() => { const wt = wByType('TBW'); return {
          id:'dip', wtype:'TBW', name:'Dipirona (Metamizol)', color:'var(--green)',
          sub:'Analgésico / antiespasmódico / antipirético', conc:'500 mg/ml (amp 2ml = 1g)', hasModes:false,
          iotRows:[
            {l:'Dose mín  15 mg/kg', v:`${f(Math.min(wt*15,1000)/500,2)} ml`, u:`= ${f(Math.min(wt*15,1000),0)} mg`},
            {l:'Dose máx  20 mg/kg', v:`${f(Math.min(wt*20,1000)/500,2)} ml`, u:`= ${f(Math.min(wt*20,1000),0)} mg`},
            {l:'Dose máx absoluta', v:'2 ml', u:'= 1g por dose'},
          ],
          iotNote:`Amp 500mg/ml (2ml=1g) | <strong>Diluir em 100ml SF — infundir em 15min</strong><br>Máx 4g/dia | Intervalo 6h`,
          badges:[{t:'Infundir lento 15min',c:'bw'},{t:'Máx 1g/dose',c:'bi'},{t:'Hipotensão se rápido',c:'br'}],
        }})(),
        (() => { const wt = wByType('TBW'); return {
          id:'ceto', wtype:'TBW', name:'Cetoprofeno', color:'var(--accent)',
          sub:'AINE EV — analgesia pós-operatória', conc:'100 mg/2ml (amp)', hasModes:false,
          iotRows:[
            {l:'Dose padrão adulto', v:'2 ml', u:'= 100 mg EV'},
            {l:'Dose  1 mg/kg (máx 100mg)', v:`${f(Math.min(wt,100)/50,2)} ml`, u:`= ${f(Math.min(wt,100),0)} mg`},
          ],
          iotNote:`Amp 100mg/2ml | <strong>Diluir em 100ml SF — infundir em 15–60min</strong><br>Intervalo: 8/8h | Máx 200mg/dia`,
          badges:[{t:'CI: sangramento',c:'br'},{t:'CI: insuf. renal',c:'br'},{t:'CI: úlcera péptica',c:'br'}],
        }})(),
        (() => { const wt = wByType('TBW'); return {
          id:'mgso4', wtype:'TBW', name:'Sulfato de Magnésio', color:'var(--purple)',
          sub:'Adjuvante analgésico / anticonvulsivante', conc:'10% = 100 mg/ml', hasModes:false,
          iotRows:[
            {l:'Adjuvante ataque  30 mg/kg', v:`${f(wt*30/100,1)} ml`, u:`(10%) em 15–20min`},
            {l:'Adjuvante ataque  50 mg/kg', v:`${f(wt*50/100,1)} ml`, u:`(10%) em 15–20min`},
            {l:'Broncoespasmo  2g', v:'20 ml', u:'(10%) em 20min'},
            {l:'Eclâmpsia  4–6g', v:'40–60 ml', u:'(10%) em 15–20min'},
          ],
          iotNote:`MgSO₄ 10% (100mg/ml) ou 50% (500mg/ml)<br>
          <strong>Manutenção adjuvante: 10–15 mg/kg/h = ${f(wt*10/100,1)}–${f(wt*15/100,1)} ml/h (10%)</strong><br>
          Manutenção eclâmpsia: 1–2g/h = 10–20ml/h (10%)`,
          badges:[{t:'Analgesia adjuvante',c:'bg'},{t:'Torsades/Arritmia',c:'bg'},{t:'Toxicidade: reflexo patelar',c:'br'}],
        }})(),
      ],
    },
    {
      hdr: 'Antieméticos (Profilaxia NVPO)',
      pre: apfelCard(),
      drugs: [
        (() => { const wt = wByType('TBW'); return {
          id:'ond', wtype:'TBW', name:'Ondansetrona', color:'var(--teal)',
          sub:'Anti-5HT₃ — antiemético 1ª linha', conc:'2 mg/ml (amp 2ml = 4mg)', hasModes:false,
          iotRows:[
            {l:'Profilaxia adulto', v:'2 ml', u:'= 4 mg IV (ao final cirurgia)'},
            {l:'Tratamento NVPO', v:'2 ml', u:'= 4 mg IV (repetir 8/8h)'},
            {l:'Dose pediátrica  0,1 mg/kg', v:`${f(Math.min(wt*0.1,4)/2,2)} ml`, u:`= ${f(Math.min(wt*0.1,4),2)} mg (máx 4mg)`},
          ],
          iotNote:`Amp 2mg/ml | Pode dar sem diluição (lento) ou diluir em 50ml SF<br>
          <strong>Dar 30min antes do fim da cirurgia para profilaxia</strong>`,
          badges:[{t:'Profilaxia NVPO',c:'bg'},{t:'Sem sedação',c:'bg'},{t:'Prolongamento QT doses altas',c:'bw'}],
        }})(),
        (() => { const wt = wByType('TBW'); return {
          id:'dex_nvpo', wtype:'TBW', name:'Dexametasona', color:'var(--orange)',
          sub:'Corticoide — antiemético / anti-inflamatório', conc:'4 mg/ml (amp 2,5ml = 10mg)', hasModes:false,
          iotRows:[
            {l:'Profilaxia NVPO', v:'1–2 ml', u:'= 4–8 mg IV (na indução)'},
            {l:'Anti-inflamatório  0,1–0,5 mg/kg', v:`${f(wt*0.1/4,2)}–${f(Math.min(wt*0.5,40)/4,2)} ml`, u:`= ${f(wt*0.1,1)}–${f(Math.min(wt*0.5,40),1)} mg`},
            {l:'Edema cerebral  0,5–1 mg/kg ataque', v:`${f(Math.min(wt*0.5,40)/4,2)}–${f(Math.min(wt,40)/4,2)} ml`, u:`= ${f(Math.min(wt*0.5,40),1)}–${f(Math.min(wt,40),1)} mg`},
          ],
          iotNote:`Amp 4mg/ml | Sem diluição (bolus lento) ou diluir em SF<br>
          <strong>NVPO: dar na indução (não no final)</strong><br>
          Máx dose única: 40mg | Hiperglicemia pós-operatória`,
          badges:[{t:'NVPO na indução',c:'bg'},{t:'Anti-inflamatório',c:'bg'},{t:'Hiperglicemia',c:'bw'},{t:'Máx 40mg',c:'bi'}],
        }})(),
      ],
    },
    {
      hdr: 'Corticosteroides',
      drugs: [
        (() => { const wt = wByType('TBW'); return {
          id:'hcort', wtype:'TBW', name:'Hidrocortisona', color:'var(--yellow)',
          sub:'Corticoide — choque, insuf. adrenal, anafilaxia', conc:'100 mg/2ml ou 500mg pó', hasModes:false,
          iotRows:[
            {l:'Dose de estresse periop.', v:'50–100 mg', u:'IV bolus (repetir 8/8h)'},
            {l:'Choque anafilático  200–500mg', v:'4–10 ml', u:'(50mg/ml) IV bolus'},
            {l:'Insuf. adrenal / sepse', v:'200 mg/dia', u:'= 50mg 6/6h ou infusão'},
            {l:'Dose antiinflamatória  1–5 mg/kg', v:`${f(wt*1/50,1)}–${f(Math.min(wt*5,500)/50,1)} ml`, u:`= ${f(wt*1,0)}–${f(Math.min(wt*5,500),0)} mg (50mg/ml)`},
          ],
          iotNote:`Amp 100mg/2ml (50mg/ml) ou pó 500mg reconstituído em 2ml<br>
          <strong>Infusão contínua sepse: 200mg em 48ml SF (4mg/ml) → 200mg/24h ≈ 2 ml/h</strong>`,
          badges:[{t:'Anafilaxia',c:'br'},{t:'Insuf. adrenal',c:'bg'},{t:'Sepse refratária',c:'bg'},{t:'Hiperglicemia',c:'bw'}],
        }})(),
      ],
    },
  ];

  let html = '';
  for (const sec of secs) {
    html += `<div class="sec-hdr">${sec.hdr}</div>` + (sec.pre || '');
    for (const d of sec.drugs) html += buildCard(d);
  }
  el.innerHTML = html;
}

/* ════════════════════════════════════════
   Anestésicos Locais
════════════════════════════════════════ */
function renderAL() {
  const el = document.getElementById('tab-al');
  const w = W();
  if (!w) { el.innerHTML = noWeight(); return; }

  // Card builder específico para AL
  // concs = [{label, pct, mgml}]
  // maxDose = min(doseKg * w, absMax)
  function alCard({ id, name, color, sub, doses, concs, onset, duration, notes, badges }) {
    let html = `<div class="drug-card">
      <div class="drug-header">
        <div>
          <div class="drug-name" style="color:${color}">${name}</div>
          <div class="drug-subtitle">${sub}</div>
        </div>
        <div class="drug-conc" style="text-align:right;line-height:1.4">
          <span style="font-size:0.6rem;color:var(--muted)">início</span><br>${onset}<br>
          <span style="font-size:0.6rem;color:var(--muted)">duração</span><br>${duration}
        </div>
      </div>`;

    // dose rows + volume table per concentration
    for (const d of doses) {
      const maxMg = Math.min(d.doseKg * w, d.absMax);
      html += `
      <div style="padding:0 14px 4px">
        <div style="font-size:0.68rem;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;
                    color:${d.vaso ? 'var(--orange)' : 'var(--muted)'};margin-bottom:6px">
          ${d.label} — dose máx: <span style="color:${color}">${f(maxMg,0)} mg</span>
          <span style="color:var(--muted);font-weight:400"> (${d.doseKg} mg/kg · máx ${d.absMax} mg)</span>
        </div>
        <table class="inf-table" style="margin-bottom:8px">
          <tr><th>Concentração</th><th>mg/ml</th><th>Vol. máx</th></tr>`;
      for (const c of concs) {
        const vol = maxMg / c.mgml;
        html += `<tr>
          <td>${c.label}</td>
          <td class="muted">${c.mgml} mg/ml</td>
          <td class="hl">${f(vol, vol >= 10 ? 0 : 1)} ml</td>
        </tr>`;
      }
      html += `</table></div>`;
    }

    if (notes) html += `<div class="dilution-note">${notes}</div>`;
    if (badges?.length) html += `<div class="badges">${badges.map(b=>`<span class="badge ${b.c}">${b.t}</span>`).join('')}</div>`;
    return html + `</div>`;
  }

  const drugs = [
    alCard({
      name: 'Lidocaína',
      color: 'var(--accent)',
      sub: 'Amida — bloqueios superficiais, venosos, espinhal',
      onset: '2–5 min', duration: '1–3 h',
      doses: [
        { label: 'Sem vasoconstritor', doseKg: 4.5, absMax: 300, vaso: false },
        { label: 'Com vasoconstritor (epi 1:200.000)', doseKg: 7, absMax: 500, vaso: true },
      ],
      concs: [
        { label: '0,5%', mgml: 5 },
        { label: '1%',   mgml: 10 },
        { label: '2%',   mgml: 20 },
      ],
      notes: `Amp 2% = 20mg/ml (20ml = 400mg)<br>
      Raquianestesia hiperbárica: 5% c/ glicose (1,5–2ml)<br>
      Peridural: 1,5–2% | Tópico: 4–10% | Venoso (Bier): 0,5%`,
      badges: [
        { t: 'Antiarrítmico Ib', c: 'bi' },
        { t: 'LAST: convulsão → arritmia', c: 'br' },
        { t: 'Intralipid 20% disponível?', c: 'bw' },
      ],
    }),
    alCard({
      name: 'Bupivacaína',
      color: 'var(--red)',
      sub: 'Amida — bloqueios longos, peridural, raquianestesia',
      onset: '15–30 min', duration: '4–12 h',
      doses: [
        { label: 'Sem vasoconstritor', doseKg: 2, absMax: 150, vaso: false },
        { label: 'Com vasoconstritor (epi 1:200.000)', doseKg: 2.5, absMax: 200, vaso: true },
      ],
      concs: [
        { label: '0,25%', mgml: 2.5 },
        { label: '0,5%',  mgml: 5   },
        { label: '0,75%', mgml: 7.5 },
      ],
      notes: `Amp 0,5% = 5mg/ml (20ml = 100mg)<br>
      Raquianestesia pesada (0,5% hiperbárica): 10–15mg = 2–3ml<br>
      Raquianestesia isobárica (0,5%): 7,5–15mg<br>
      Peridural analgesia: 0,1–0,25% | Peridural bloqueio: 0,5%`,
      badges: [
        { t: 'MAIS cardiotóxica', c: 'br' },
        { t: 'Evitar IV — fibrilação refratária', c: 'br' },
        { t: 'Intralipid 20% obrigatório disponível', c: 'bw' },
      ],
    }),
    alCard({
      name: 'Levobupivacaína',
      color: 'var(--orange)',
      sub: 'Amida — isômero S(−) da bupivacaína, menos tóxica',
      onset: '15–30 min', duration: '4–12 h',
      doses: [
        { label: 'Dose máxima', doseKg: 2, absMax: 150, vaso: false },
      ],
      concs: [
        { label: '0,25%', mgml: 2.5 },
        { label: '0,5%',  mgml: 5   },
        { label: '0,75%', mgml: 7.5 },
      ],
      notes: `Amp 0,5% = 5mg/ml (10ml = 50mg / 20ml = 100mg)<br>
      Perfil clínico similar à bupivacaína<br>
      Peridural bloqueio: 0,5–0,75% | Analgesia: 0,1–0,25%<br>
      Raquianestesia: 0,5% isobárica 10–15mg`,
      badges: [
        { t: 'Menos cardiotóxica que Bupivacaína', c: 'bg' },
        { t: 'LAST possível — mesma precaução', c: 'bw' },
      ],
    }),
    alCard({
      name: 'Ropivacaína',
      color: 'var(--green)',
      sub: 'Amida — bloqueios periféricos, peridural, menos tóxica',
      onset: '10–20 min', duration: '4–8 h',
      doses: [
        { label: 'Dose máxima', doseKg: 3, absMax: 250, vaso: false },
      ],
      concs: [
        { label: '0,2%',  mgml: 2   },
        { label: '0,5%',  mgml: 5   },
        { label: '0,75%', mgml: 7.5 },
        { label: '1%',    mgml: 10  },
      ],
      notes: `Amp 0,75% = 7,5mg/ml (10ml = 75mg / 20ml = 150mg)<br>
      Analgesia peridural/bloqueio contínuo: 0,2%<br>
      Bloqueios periféricos: 0,5–0,75% | Peridural cirúrgico: 0,75–1%<br>
      Possui leve vasoconstrição intrínseca`,
      badges: [
        { t: 'Menos cardiotóxica', c: 'bg' },
        { t: 'Vasoconstrição intrínseca', c: 'bg' },
        { t: 'Preferida em bloqueios periféricos', c: 'bi' },
      ],
    }),
  ];

  // Aviso LAST + Intralipid
  let html = `<div class="drug-card" style="background:rgba(224,80,80,0.06);border-color:rgba(224,80,80,0.25);margin-bottom:14px">
    <div style="padding:14px 16px">
      <div class="drug-name" style="color:var(--red);font-size:0.9rem;margin-bottom:8px">⚠️ LAST — Toxicidade Sistêmica de Anestésico Local</div>
      <div style="font-size:0.78rem;color:var(--text);line-height:1.6">
        <strong>SNC:</strong> zumbido, gosto metálico, agitação → convulsão → coma<br>
        <strong>CV:</strong> bradicardia, bloqueio, TV/FV refratária (bupivacaína)<br>
        <strong>Tratamento:</strong> parar injeção · via aérea · ACLS · <strong style="color:var(--yellow)">Intralipid 20%</strong><br>
        &nbsp;&nbsp;Bolus: <strong>${w > 70 ? '100 ml' : f(w*1.5,0)+' ml'}</strong> (1,5ml/kg; 100 ml se &gt;70kg) em 2–3min<br>
        &nbsp;&nbsp;Infusão: <strong>${w > 70 ? '200–250 ml em 15–20min' : f(w*0.25,1)+' ml/min'}</strong> (0,25ml/kg/min)<br>
        &nbsp;&nbsp;Dose máx: <strong>${f(w*12,0)} ml</strong> (12ml/kg) · ASRA 2020
      </div>
    </div>
  </div>`;

  html += `<div class="sec-hdr">Anestésicos Locais — Dose Máxima por Concentração</div>`;
  for (const d of drugs) html += d;
  el.innerHTML = html;
}

/* ════════════════════════════════════════
   Vasoativos
════════════════════════════════════════ */
function renderVaso() {
  const w = W();
  const el = document.getElementById('tab-vaso');
  if (!w) { el.innerHTML = noWeight(); return; }

  function mkVaso(name, color, sub, conc_mcgml, doseLabel, dosesArr, dilNote, badges, efeitoFn) {
    let rows = '';
    dosesArr.forEach(d => {
      const mlh = d * w * 60 / conc_mcgml;
      rows += `<tr><td>${d}</td><td class="muted">${efeitoFn ? efeitoFn(d) : ''}</td><td class="hl">${f(mlh,1)}</td></tr>`;
    });
    const bdg = badges.map(b => `<span class="badge ${b.c}">${b.t}</span>`).join('');
    return `<div class="drug-card">
      <div class="drug-header">
        <div><div class="drug-name" style="color:${color}">${name}</div><div class="drug-subtitle">${sub}</div></div>
        <div class="drug-conc">${doseLabel}</div>
      </div>
      <div class="dilution-note">${dilNote}</div>
      <div class="dose-table">
        <table class="inf-table">
          <tr><th>Dose (mcg/kg/min)</th><th>Efeito</th><th>ml/h</th></tr>
          ${rows}
        </table>
      </div>
      <div class="badges">${bdg}</div>
    </div>`;
  }

  // Noradrenalina: 4mg/4ml → 4mg + 196ml SF → 20mcg/ml
  const nora = mkVaso(
    'Noradrenalina', 'var(--accent)', 'Vasopressor 1ª linha — choque',
    20, 'mcg/kg/min',
    [0.05, 0.1, 0.15, 0.2, 0.3],
    `Amp 4mg/4ml → <strong>4ml + 196ml SF = 20 mcg/ml</strong><br>Dose: 0,01–0,5 mcg/kg/min | Iniciar: 0,05–0,1`,
    [{ t:'Sepse 1ª linha', c:'bg' }, { t:'Isquemia periférica doses altas', c:'bw' }],
    d => d<=0.1?'Início':d<=0.2?'Manutenção':'Alta dose'
  );

  // Dopamina: 5 amp 50mg/10ml → 250mg + 200ml SF → ~1,1mg/ml ≈ usar 5 amp em 200ml = 1mg/ml = 1000mcg/ml
  const dopa = mkVaso(
    'Dopamina', 'var(--purple)', 'Inotrópico/vasopressor — dose dependente',
    1000, 'mcg/kg/min',
    [2, 5, 10, 15, 20],
    `5 amp (50mg/10ml) + 200ml SF → <strong>1 mg/ml (1000 mcg/ml)</strong><br>&lt;5: dopaminérgico | 5-10: β¹/β² | &gt;10: α`,
    [{ t:'Taquiarritmia >20mcg', c:'bw' }, { t:'Menos usado hoje', c:'bi' }],
    d => d<5?'Dopaminérgico':d<=10?'β¹ inotrópico':'α vasopressor'
  );

  // Dobutamina: 1 amp 250mg/20ml → 1 amp + 230ml SF → 1mg/ml = 1000mcg/ml
  const dobut = mkVaso(
    'Dobutamina', 'var(--green)', 'Inotrópico — IC baixo débito',
    1000, 'mcg/kg/min',
    [2, 5, 10, 15, 20],
    `Amp 250mg/20ml | <strong>1 amp + 230ml SF → 1mg/ml</strong><br>ou concentrada: 4 amp + 170ml → 4mg/ml (÷4 o ml/h)<br>Dose: 2–20 mcg/kg/min (máx 50)`,
    [{ t:'IC baixo débito', c:'bg' }, { t:'Taquiarritmia alto risco', c:'bw' }],
    d => d<=5?'Inotrópico':d<=10?'↑DC moderado':'Alto débito'
  );

  // Adrenalina: 1mg/ml → 1mg + 188ml SF → 60mcg/ml
  const adre = mkVaso(
    'Adrenalina (Epinefrina)', 'var(--red)', 'Vasopressor/inotrópico — PCR / anafilaxia',
    60, 'mcg/kg/min',
    [0.05, 0.1, 0.3, 0.5, 1.0, 2.0],
    `Amp 1mg/ml | <strong>12mg (12ml) + 188ml SF → 60 mcg/ml</strong><br>PCR: 1mg bolus EV a cada 3-5min | Anafilaxia: 0,3mg IM`,
    [{ t:'PCR: 1mg bolus', c:'br' }, { t:'Anafilaxia: 0,3mg IM', c:'bw' }],
    d => d<=0.1?'Baixa':d<=0.5?'Moderada':'Alta'
  );

  // Tridil (Nitroglicerina) — dose em mcg/min (não por peso)
  const tridilDoses = [5, 10, 20, 40, 60, 100, 200];
  // Amp 5mg/ml (5ml=25mg) → diluir 50mg em 250ml SG5% = 0,2mg/ml = 200mcg/ml
  const tridilConc = 200; // mcg/ml
  let tridilRows = '';
  tridilDoses.forEach(d => {
    const mlh = d * 60 / tridilConc;
    tridilRows += `<tr><td>${d}</td><td class="muted">${d<=20?'Angioplast.':d<=60?'Angina/HAS':'Emergência'}</td><td class="hl">${f(mlh,1)}</td></tr>`;
  });

  const tridil = `<div class="drug-card">
    <div class="drug-header">
      <div><div class="drug-name" style="color:var(--yellow)">Tridil (Nitroglicerina)</div><div class="drug-subtitle">Vasodilatador venoso — angina, HAS, ICC</div></div>
      <div class="drug-conc">mcg/min</div>
    </div>
    <div class="dilution-note">Amp 5mg/ml | <strong>50mg (10ml) + 240ml SG5% → 0,2mg/ml (200 mcg/ml)</strong><br>
    Dose: 5–200 mcg/min | <strong>Dose não é por peso</strong><br>Usar vidro/equipo opaco. Tolerância em 24-48h.</div>
    <div class="dose-table"><table class="inf-table">
      <tr><th>Dose (mcg/min)</th><th>Indicação</th><th>ml/h</th></tr>
      ${tridilRows}
    </table></div>
    <div class="badges"><span class="badge bg">Angina instável</span><span class="badge bg">IC aguda</span><span class="badge bw">Tolerância 24-48h</span><span class="badge br">CI: hipotensão, sildenafil</span></div>
  </div>`;

  // Nipride (Nitroprussiato) — mcg/kg/min, proteger da luz
  const nipConc_mcgml = 200; // 50mg em 250ml SG5% → 0,2mg/ml = 200mcg/ml
  const nipDoses = [0.3, 0.5, 1.0, 2.0, 3.0, 5.0, 8.0, 10.0];
  let nipRows = '';
  nipDoses.forEach(d => {
    const mlh = d * w * 60 / nipConc_mcgml;
    const eff = d <= 0.5 ? 'Mín' : d <= 2 ? 'Moderado' : d <= 5 ? 'Alto' : 'Máx (cianeto!)';
    nipRows += `<tr><td>${d}</td><td class="muted">${eff}</td><td class="hl">${f(mlh,1)}</td></tr>`;
  });

  const nipride = `<div class="drug-card" style="border-color: rgba(244,196,48,0.25)">
    <div class="drug-header">
      <div><div class="drug-name" style="color:var(--yellow)">Nipride (Nitroprussiato)</div><div class="drug-subtitle">Vasodilatador arteriolar — crise hipertensiva</div></div>
      <div class="drug-conc">mcg/kg/min</div>
    </div>
    <div class="dilution-note" style="border-left: 2px solid var(--yellow); border-radius: 0 8px 8px 0; padding-left:10px">
      ⚠️ <strong>PROTEGER DA LUZ</strong> (papel alumínio)<br>
      Amp 50mg/5ml | <strong>50mg + 245ml SG5% → 0,2mg/ml (200 mcg/ml)</strong><br>
      Dose: 0,3–10 mcg/kg/min | Toxicidade por cianeto &gt;3 mcg/kg/min por &gt;72h<br>
      Máximo: <strong>10 mcg/kg/min</strong></div>
    <div class="dose-table"><table class="inf-table">
      <tr><th>Dose (mcg/kg/min)</th><th>Risco</th><th>ml/h</th></tr>
      ${nipRows}
    </table></div>
    <div class="badges"><span class="badge br">Proteger da luz obrigatório</span><span class="badge bw">Toxicidade cianeto &gt;3 mcg/kg/min</span><span class="badge bi">Meia-vida: 2min</span></div>
  </div>`;

  let html = `<div class="sec-hdr">Vasopressores</div>`;
  html += nora + dopa;
  html += `<div class="sec-hdr">Inotrópicos</div>`;
  html += dobut + adre;
  html += `<div class="sec-hdr">Vasodilatadores</div>`;
  html += tridil + nipride;

  el.innerHTML = html;
}

/* ════════════════════════════════════════
   PCR
════════════════════════════════════════ */
function renderPCR() {
  const w = W();
  const el = document.getElementById('tab-pcr');

  function row(l, v) {
    return `<div class="pcr-row"><span class="pcr-l">${l}</span><span class="pcr-v">${v}</span></div>`;
  }

  let html = `<div class="sec-hdr">Drogas de PCR</div>`;

  html += `<div class="pcr-card">
    <div class="pcr-title">🔴 ADRENALINA</div>
    ${row('Dose adulto', '1 mg EV/IO bolus')}
    ${row('Intervalo', 'A cada 3–5 minutos')}
    ${row('Apresentação', 'Amp 1mg/ml (1ml)')}
    ${w ? row('Pediátrico 0,01 mg/kg', `${f(w*0.01,3)} mg = ${f(w*0.1,1)} ml de 0,1mg/ml (1ml + 9ml SF)`) : ''}
    ${row('Pós-PCR', '0,1–0,5 mcg/kg/min infusão')}
  </div>`;

  html += `<div class="pcr-card">
    <div class="pcr-title">🔴 AMIODARONA — FV/TV sem pulso</div>
    ${row('1ª dose', '300 mg EV bolus (em 20ml SG5%)')}
    ${row('2ª dose', '150 mg EV bolus')}
    ${row('Manutenção pós-reversão', '1 mg/min × 6h → 0,5 mg/min × 18h')}
    ${row('Apresentação', '150mg/3ml (50mg/ml)')}
  </div>`;

  html += `<div class="pcr-card">
    <div class="pcr-title">🟡 ATROPINA — Bradicardia</div>
    ${row('Dose', '1 mg EV — repetir até 3mg total (AHA 2020)')}
    ${row('Intervalo', '3–5 minutos')}
    ${row('Obs', 'Dose <0,5mg pode causar bradicardia paradoxal')}
  </div>`;

  html += `<div class="pcr-card">
    <div class="pcr-title">🟡 BICARBONATO — Hipercalemia / Acidose</div>
    ${w ? row('Dose (1 mEq/kg)', `${f(w,0)} mEq = ${f(w,0)} ml (NaHCO₃ 8,4%)`) : row('Dose','1 mEq/kg')}
    ${row('Indicação', 'Hipercalemia, pH <6,9, intox. ATC')}
    ${row('Cuidado', 'Não misturar com Ca²⁺')}
  </div>`;

  html += `<div class="pcr-card" style="border-color:rgba(77,142,247,0.25);background:rgba(77,142,247,0.05)">
    <div class="pcr-title" style="color:var(--accent)">🔵 SULFATO DE MAGNÉSIO</div>
    ${row('Torsades de Pointes', '1–2 g EV em 15min')}
    ${row('PCR por Torsades', '1–2 g bolus EV')}
    ${row('Eclâmpsia', '4–6 g em 15–20min → manutenção 1–2 g/h')}
    ${row('Apresentação', 'MgSO₄ 10% (100mg/ml)')}
  </div>`;

  html += `<div class="pcr-card">
    <div class="pcr-title">🔴 DESFIBRILAÇÃO</div>
    ${row('Bifásico', '120–200 J (conforme fabricante)')}
    ${row('Monofásico', '360 J')}
    ${w ? row('Pediátrico (2 J/kg → 4 J/kg)', `1º choque ${f(w*2,0)} J · depois ${f(w*4,0)} J (máx 10 J/kg)`) : ''}
    ${row('RCP pós-choque', 'Retomar imediatamente por 2 min')}
  </div>`;

  el.innerHTML = html;
}

/* ════════════════════════════════════════
   Card builder
════════════════════════════════════════ */
function buildCard(d) {
  const mode = modes[d.id] || 'iot';
  if (d.wtype && wByType(d.wtype) === weights.tbw) d.wtype = 'TBW'; // sem altura ou paciente magro → peso real
  const wtColor = wTypeColor[d.wtype] || 'var(--muted)';

  let html = `<div class="drug-card">
    <div class="drug-header">
      <div>
        <div class="drug-name" style="color:${d.color}">${d.name}${d.wtype ? `<span class="wtype-badge" style="color:${wtColor};border-color:${wtColor}20;background:${wtColor}15">${d.wtype}</span>` : ''}</div>
        <div class="drug-subtitle">${d.sub}</div>
      </div>
      <div class="drug-conc">${d.conc}</div>
    </div>`;

  if (d.hasModes) {
    html += `<div class="mode-toggle">
      <button class="mode-btn ${mode==='iot'?'active':''}" onclick="toggleMode('${d.id}','iot')">Bolus / IOT</button>
      <button class="mode-btn ${mode==='inf'?'active':''}" onclick="toggleMode('${d.id}','inf')">Infusão Contínua</button>
    </div>`;
  }

  if (!d.hasModes || mode === 'iot') {
    if (d.iotRows && d.iotRows.length > 0) {
      html += `<div class="dose-table">`;
      d.iotRows.forEach(r => {
        html += `<div class="dose-row">
          <span class="dose-label">${r.l}</span>
          <span class="dose-val">${r.v}<span class="dose-unit">${r.u||''}</span></span>
        </div>`;
      });
      html += `</div>`;
    }
    if (d.iotNote) html += `<div class="dilution-note">${d.iotNote}</div>`;
  }

  if (d.hasModes && mode === 'inf') {
    html += d.infTable || '';
    if (d.infNote) html += `<div class="dilution-note">${d.infNote}</div>`;
  }

  if (!d.hasModes && d.infTable) {
    html += d.infTable;
    if (d.infNote) html += `<div class="dilution-note">${d.infNote}</div>`;
  }

  if (d.badges && d.badges.length) {
    html += `<div class="badges">${d.badges.map(b=>`<span class="badge ${b.c}">${b.t}</span>`).join('')}</div>`;
  }

  return html + `</div>`;
}

/* infusion table helper */
function infTable_wt(wt, rows, unitLabel) {
  let t = `<div class="dose-table"><table class="inf-table">
    <tr><th>Dose (${unitLabel})</th><th>Efeito</th><th>ml/h</th></tr>`;
  rows.forEach(({d, eff, conc_mcg_ml}) => {
    const mlh = d * wt / conc_mcg_ml;
    t += `<tr><td>${d}</td><td class="muted">${eff}</td><td class="hl">${f(mlh, mlh < 1 ? 2 : 1)}</td></tr>`;
  });
  return t + `</table></div>`;
}

/* ════════════════════════════════════════
   Hidratação Perioperatória
════════════════════════════════════════ */
function renderHid() {
  const el = document.getElementById('hid-out');
  const w = W();
  const jejum = parseFloat(document.getElementById('jejum').value) || 0;
  const htI = parseFloat(document.getElementById('ht-i').value) || 0;
  const htF = parseFloat(document.getElementById('ht-f').value) || 0;

  // Holliday-Segar: 4-2-1 rule
  function maintenance(kg) {
    let r = 0;
    if (kg <= 10)       r = 4 * kg;
    else if (kg <= 20)  r = 40 + 2 * (kg - 10);
    else                r = 60 + 1 * (kg - 20);
    return r; // ml/h
  }

  const maint = w ? maintenance(w) : 0;
  const deficit = maint * jejum;
  const h1 = deficit * 0.5 + maint;
  const h2 = deficit * 0.25 + maint;
  const h3 = deficit * 0.25 + maint;

  let html = '';

  if (!w) { el.innerHTML = html + noWeight(); return; }

  html += `<div class="drug-card">
    <div class="drug-header">
      <div><div class="drug-name" style="color:var(--green)">Taxa de Manutenção</div>
      <div class="drug-subtitle">4 ml/kg/h (≤10kg) + 2 ml/kg/h (10–20kg) + 1 ml/kg/h (&gt;20kg)</div></div>
      <div class="drug-conc">${f(maint,0)} ml/h</div>
    </div>
    <div class="dose-table">
      <div class="dose-row"><span class="dose-label">Manutenção/hora</span><span class="dose-val">${f(maint,0)}<span class="dose-unit"> ml/h</span></span></div>
      <div class="dose-row"><span class="dose-label">Manutenção/dia</span><span class="dose-val">${f(maint*24,0)}<span class="dose-unit"> ml/24h</span></span></div>
    </div>
  </div>`;

  if (jejum > 0) {
    html += `<div class="drug-card">
      <div class="drug-header">
        <div><div class="drug-name" style="color:var(--orange)">Déficit de Jejum</div>
        <div class="drug-subtitle">Manutenção × horas de jejum — repor nas primeiras 3h</div></div>
        <div class="drug-conc">${f(deficit,0)} ml</div>
      </div>
      <div class="dose-table">
        <div class="dose-row"><span class="dose-label">Déficit total (${f(maint,0)} × ${jejum}h)</span><span class="dose-val">${f(deficit,0)}<span class="dose-unit"> ml</span></span></div>
        <div class="dose-row" style="background:rgba(77,142,247,0.05);border-radius:6px;padding:8px 6px;margin-top:4px">
          <span class="dose-label">🕐 1ª hora (50% déficit + manutenção)</span>
          <span class="dose-val" style="color:var(--accent)">${f(h1,0)}<span class="dose-unit"> ml/h</span></span>
        </div>
        <div class="dose-row">
          <span class="dose-label">🕑 2ª hora (25% déficit + manutenção)</span>
          <span class="dose-val">${f(h2,0)}<span class="dose-unit"> ml/h</span></span>
        </div>
        <div class="dose-row">
          <span class="dose-label">🕒 3ª hora (25% déficit + manutenção)</span>
          <span class="dose-val">${f(h3,0)}<span class="dose-unit"> ml/h</span></span>
        </div>
      </div>
    </div>`;
  }

  // Perda sanguínea permitida (Gross): VSE × (Hti − Htf) / Ht médio
  const vse = w * (sex === 'F' ? 65 : 75);
  const abl = htI > htF && htF > 0 ? vse * (htI - htF) / ((htI + htF) / 2) : 0;
  html += `<div class="drug-card">
    <div class="drug-header">
      <div><div class="drug-name" style="color:var(--red)">Perda Sanguínea Permitida</div>
      <div class="drug-subtitle">VSE × (Ht inicial − Ht mínimo) / Ht médio</div></div>
      <div class="drug-conc">${abl ? f(abl,0)+' ml' : 'informe Ht'}</div>
    </div>
    <div class="dose-table">
      <div class="dose-row"><span class="dose-label">Volemia estimada (${sex==='F'?65:75} ml/kg)</span><span class="dose-val">${f(vse,0)}<span class="dose-unit"> ml</span></span></div>
      ${abl ? `<div class="dose-row"><span class="dose-label">Perda permitida (Ht ${htI}% → ${htF}%)</span><span class="dose-val" style="color:var(--red)">${f(abl,0)}<span class="dose-unit"> ml</span></span></div>` : ''}
    </div>
    <div class="dilution-note">Obeso: volemia por kg é menor — o valor superestima a perda permitida.</div>
  </div>`;

  html += `<div class="drug-card">
    <div class="drug-header">
      <div><div class="drug-name" style="color:var(--purple)">Perdas Intraoperatórias</div>
      <div class="drug-subtitle">Adicionar à manutenção conforme trauma cirúrgico</div></div>
    </div>
    <div class="dose-table">
      <div class="dose-row"><span class="dose-label">Trauma mínimo  2–4 ml/kg/h</span><span class="dose-val">${f(w*2,0)}–${f(w*4,0)}<span class="dose-unit"> ml/h</span></span></div>
      <div class="dose-row"><span class="dose-label">Trauma moderado  4–6 ml/kg/h</span><span class="dose-val">${f(w*4,0)}–${f(w*6,0)}<span class="dose-unit"> ml/h</span></span></div>
      <div class="dose-row"><span class="dose-label">Trauma grave  6–10 ml/kg/h</span><span class="dose-val">${f(w*6,0)}–${f(w*10,0)}<span class="dose-unit"> ml/h</span></span></div>
    </div>
    <div class="dilution-note">Repor sangramento 1:3 (cristaloide) ou 1:1 (coloide/CH)<br>
    Hto alvo: ≥21% (saudável) / ≥28% (cardiopata) | Diurese: 0,5–1 ml/kg/h</div>
  </div>`;

  el.innerHTML = html;
}

update();

/* ════════════════════════════════════════
   Voláteis — Consumo de Anestésicos Inalatórios
════════════════════════════════════════ */
const VOL_AGENTS = {
  sevo: {name:'Sevorane',  d:1.53, pm:200.05, mac40:1.80},
  iso:  {name:'Isoflurano',d:1.49, pm:184.5,  mac40:1.17},
  des:  {name:'Desflurano',d:1.47, pm:168.04, mac40:6.6 },
  halo: {name:'Halotano',  d:1.87, pm:197.38, mac40:0.75},
};
let volCurrentAgent = 'sevo';
let volChartInst = null;

function volSetAgent(key, btn) {
  volCurrentAgent = key;
  document.querySelectorAll('#tab-vol .v-tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('vol-tot-agent').textContent = VOL_AGENTS[key].name;
  volCalc();
}

function volGetFactor(temp) {
  const a = VOL_AGENTS[volCurrentAgent];
  return (a.d * 22400 * (273 + temp)) / (a.pm * 273);
}

function volTimeStrToMin(val) {
  if (!val) return 0;
  const [h, m] = val.split(':').map(Number);
  return h * 60 + m;
}

function volAddMinutes(timeVal, mins) {
  const base = volTimeStrToMin(timeVal);
  const total = (base + mins) % (24 * 60);
  const h = Math.floor(total / 60);
  const m = total % 60;
  return String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0');
}

function volUpdateSliderFill(slider) {
  const min = parseFloat(slider.min), max = parseFloat(slider.max), val = parseFloat(slider.value);
  slider.style.setProperty('--pct', ((val - min) / (max - min) * 100).toFixed(1) + '%');
}

function volGetDur(phase) {
  return Math.max(1, parseInt(document.getElementById('vol-' + phase + '-dur-val').value) || 1);
}

function volUpdateTimeDisplay(phase) {
  const startEl = document.getElementById('vol-' + phase + '-start');
  const dur = volGetDur(phase);
  document.getElementById('vol-' + phase + '-display-start').textContent = startEl.value || '—';
  document.getElementById('vol-' + phase + '-end-display').textContent = volAddMinutes(startEl.value, dur);
  volUpdateSliderFill(document.getElementById('vol-' + phase + '-dur-slide'));
}

function volMlLiq(c, fl, d, factor) { return (c / 100) * fl * d * 1000 / factor; }

function volBuildChart(sC, sF, sD, mC, mF, mD, factor) {
  const cs = getComputedStyle(document.documentElement);
  const cY = cs.getPropertyValue('--yellow').trim();
  const cG = cs.getPropertyValue('--green').trim();
  const cA = cs.getPropertyValue('--accent').trim();
  const cM = cs.getPropertyValue('--muted').trim();
  const cB = cs.getPropertyValue('--border').trim();

  const totalMin = sD + mD;
  const step = Math.max(1, Math.round(totalMin / 40));
  const labels = [], satData = [], manData = [], cumData = [];
  let cum = 0;
  for (let t = 0; t < totalMin; t += step) {
    labels.push(t + 'm');
    const inSat = t < sD;
    const dS = inSat ? volMlLiq(sC, sF, step, factor) : 0;
    const dM = inSat ? 0 : volMlLiq(mC, mF, step, factor);
    satData.push(parseFloat(dS.toFixed(2)));
    manData.push(parseFloat(dM.toFixed(2)));
    cum += dS + dM;
    cumData.push(parseFloat(cum.toFixed(2)));
  }

  const ctx = document.getElementById('vol-chart').getContext('2d');
  if (volChartInst) volChartInst.destroy();
  volChartInst = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [
        {label:'Saturação', data:satData, backgroundColor:cY+'b3', borderRadius:2, order:2},
        {label:'Manutenção',data:manData, backgroundColor:cG+'b3', borderRadius:2, order:2},
        {label:'Acumulado', data:cumData, type:'line', borderColor:cA,
         backgroundColor:cA+'20', borderWidth:2, pointRadius:0,
         fill:true, yAxisID:'y2', order:1, tension:.3}
      ]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins: {
        legend:{display:false},
        tooltip:{
          backgroundColor:'var(--card)', borderColor:cB, borderWidth:1,
          titleColor:cM, bodyColor:'var(--text)',
          callbacks:{label:c=>c.dataset.label+': '+c.parsed.y.toFixed(1)+' mL'}
        }
      },
      scales:{
        x:{stacked:true, ticks:{color:cM,font:{size:10}}, grid:{color:cB+'66'}, border:{color:cB}},
        y:{stacked:true, ticks:{color:cM,font:{size:10}}, grid:{color:cB+'66'}, border:{color:cB},
           title:{display:true,text:'mL/intervalo',color:cM,font:{size:10}}},
        y2:{position:'right', ticks:{color:cA,font:{size:10}}, grid:{display:false}, border:{color:cA+'44'},
            title:{display:true,text:'acumulado (mL)',color:cA,font:{size:10}}}
      }
    }
  });
}

function volCalc() {
  if (typeof Chart === 'undefined') return;
  const tempEl = document.getElementById('vol-temp');
  if (!tempEl) return;

  const temp = parseFloat(tempEl.value);
  document.getElementById('vol-temp-v').textContent = temp;
  const factor = volGetFactor(temp);
  document.getElementById('vol-factor-v').textContent = factor.toFixed(0);

  volUpdateTimeDisplay('s');
  // sync maintenance start to saturation end
  const sStartVal = document.getElementById('vol-s-start').value;
  const sDurSync  = volGetDur('s');
  document.getElementById('vol-m-start').value = volAddMinutes(sStartVal, sDurSync);
  volUpdateTimeDisplay('m');

  const sD = volGetDur('s'), mD = volGetDur('m');
  const sC = parseFloat(document.getElementById('vol-s-conc').value);
  const sF = parseFloat(document.getElementById('vol-s-flow').value);
  const mC = parseFloat(document.getElementById('vol-m-conc').value);
  const mF = parseFloat(document.getElementById('vol-m-flow').value);

  document.getElementById('vol-s-conc-v').textContent = sC.toFixed(1);
  document.getElementById('vol-s-flow-v').textContent = sF.toFixed(1);
  document.getElementById('vol-m-conc-v').textContent = mC.toFixed(1);
  document.getElementById('vol-m-flow-v').textContent = mF.toFixed(1);

  // CAM pela idade: MAC40 × 10^(−0,00269 × (idade − 40)); sem idade, assume 40
  const age = parseFloat(document.getElementById('age').value) || 40;
  const mac = VOL_AGENTS[volCurrentAgent].mac40 * Math.pow(10, -0.00269 * (age - 40));
  document.getElementById('vol-age').textContent = age;
  document.getElementById('vol-mac').textContent = mac.toFixed(2);
  document.getElementById('vol-s-mac').textContent = '= ' + (sC / mac).toFixed(1) + ' CAM';
  document.getElementById('vol-m-mac').textContent = '= ' + (mC / mac).toFixed(1) + ' CAM';

  const sMl = volMlLiq(sC, sF, sD, factor);
  const mMl = volMlLiq(mC, mF, mD, factor);
  const total = sMl + mMl;
  const totalDur = sD + mD;

  document.getElementById('vol-s-ml').textContent   = sMl.toFixed(1);
  document.getElementById('vol-s-vap').textContent  = ((sC/100)*sF*sD).toFixed(1);
  document.getElementById('vol-s-rate').textContent = ((sMl/sD)*60).toFixed(1);
  document.getElementById('vol-m-ml').textContent   = mMl.toFixed(1);
  document.getElementById('vol-m-vap').textContent  = ((mC/100)*mF*mD).toFixed(1);
  document.getElementById('vol-m-rate').textContent = ((mMl/mD)*60).toFixed(1);


  document.getElementById('vol-tot-all').textContent = total.toFixed(1);
  document.getElementById('vol-tot-sat').textContent = sMl.toFixed(1);
  document.getElementById('vol-tot-man').textContent = mMl.toFixed(1);
  const h = Math.floor(totalDur/60), m = totalDur%60;
  document.getElementById('vol-tot-dur').textContent = h>0 ? h+'h '+m+'min' : m+' min';
  document.getElementById('vol-warn-box').classList.toggle('visible', total>50);

  volBuildChart(sC, sF, sD, mC, mF, mD, factor);
}

/* ════════════════════════════════════════
   Exames
════════════════════════════════════════ */
// [idade máx em dias, Hb média, Hb mín, Ht médio, Ht mín] — Nathan & Oski (Harriet Lane), −2 DP
const HB_REF = [
  [0,   16.5, 13.5, 51, 42, 'Cordão'],
  [3,   18.5, 14.5, 56, 45, '1–3 dias'],
  [10,  17.5, 13.5, 54, 42, '1 semana'],
  [21,  16.5, 12.5, 51, 39, '2 semanas'],
  [45,  14.0, 10.0, 43, 31, '1 mês'],
  [75,  11.5,  9.0, 35, 28, '2 meses'],
  [182, 11.5,  9.5, 35, 29, '3–6 meses'],
  [730, 12.0, 10.5, 36, 33, '6 m – 2 anos'],
  [2190,12.5, 11.5, 37, 34, '2–6 anos'],
  [4380,13.5, 11.5, 40, 35, '6–12 anos'],
];
function hbRef(days, s) {
  const r = HB_REF.find(r => days <= r[0]);
  if (r) return r;
  if (days < 18*365) return s === 'F' ? [0, 14.0, 12.0, 41, 36, '12–18 anos ♀'] : [0, 14.5, 13.0, 43, 37, '12–18 anos ♂'];
  return s === 'F' ? [0, 13.5, 12.0, 41, 36, 'Adulto ♀ (OMS)'] : [0, 15.0, 13.0, 45, 39, 'Adulto ♂ (OMS)'];
}

// CKD-EPI 2021 (Inker, NEJM 2021) — sem coeficiente de raça
function ckdEpi(cr, age, s) {
  const k = s === 'F' ? 0.7 : 0.9, a = s === 'F' ? -0.241 : -0.302;
  return 142 * Math.min(cr/k, 1)**a * Math.max(cr/k, 1)**-1.2 * 0.9938**age * (s === 'F' ? 1.012 : 1);
}
const cockcroft = (cr, age, kg, s) => (140 - age) * kg / (72 * cr) * (s === 'F' ? 0.85 : 1);

function renderLab() {
  const v = id => parseFloat(document.getElementById(id).value) || 0;
  const line = (l, val, color) => `<div class="dose-row"><span class="dose-label">${l}</span><span class="dose-val"${color ? ` style="color:${color}"` : ''}>${val}</span></div>`;
  const note = t => `<div class="dilution-note">${t}</div>`;
  const panelAge = v('age');

  // Hb / Ht
  const days = v('lab-age') ? v('lab-age') * v('lab-age-u') : panelAge * 365;
  const hb = v('lab-hb'), ht = v('lab-ht');
  let o = '';
  if (days || document.getElementById('lab-age').value === '0') {
    const [, hbM, hbMin, htM, htMin, faixa] = hbRef(days, sex);
    o = `<div class="dose-table">${line('Faixa', faixa)}${line('Hb média / mínima', `${hbM} / ${hbMin}<span class="dose-unit"> g/dL</span>`)}${line('Ht médio / mínimo', `${htM} / ${htMin}<span class="dose-unit"> %</span>`)}`;
    if (hb) o += line('Hb do paciente', hb < hbMin ? `${hb} — baixa` : `${hb} — normal`, hb < hbMin ? 'var(--red)' : 'var(--green)');
    if (ht) o += line('Ht do paciente', ht < htMin ? `${ht} — baixo` : `${ht} — normal`, ht < htMin ? 'var(--red)' : 'var(--green)');
    o += '</div>' + note('Sem idade no card, usa a idade do painel. Gestante (OMS): anemia se Hb &lt;11 (1º/3º tri) ou &lt;10,5 (2º tri).');
  } else o = note('Informe a idade (ou preencha no painel).');
  document.getElementById('lab-hb-out').innerHTML = o;

  // Filtração glomerular
  const cr = v('lab-cr');
  if (!cr) o = note('Informe a creatinina.');
  else if (panelAge < 18) o = note('Informe idade ≥ 18 anos no painel (fórmulas de adulto).');
  else {
    const g = ckdEpi(cr, panelAge, sex);
    const est = g >= 90 ? 'G1' : g >= 60 ? 'G2' : g >= 45 ? 'G3a' : g >= 30 ? 'G3b' : g >= 15 ? 'G4' : 'G5';
    o = `<div class="dose-table">${line('CKD-EPI 2021', `${f(g,0)}<span class="dose-unit"> mL/min/1,73m² · ${est}</span>`, g < 60 ? 'var(--orange)' : '')}`;
    const w = W(), ibw = weights.ibw;
    if (w) {
      o += line('Cockcroft-Gault (peso real)', `${f(cockcroft(cr, panelAge, w, sex),0)}<span class="dose-unit"> mL/min</span>`);
      if (ibw && w > ibw * 1.2) o += line('Cockcroft-Gault (peso ajustado)', `${f(cockcroft(cr, panelAge, weights.abw, sex),0)}<span class="dose-unit"> mL/min</span>`);
    }
    o += '</div>' + note('Ajuste de dose de drogas: bulas usam Cockcroft-Gault. Obeso: preferir peso ajustado.');
  }
  document.getElementById('lab-cr-out').innerHTML = o;

  // HOMA
  const gli = v('lab-gli'), ins = v('lab-ins');
  if (gli && ins) {
    const ir = gli * ins / 405, beta = gli > 63 ? 360 * ins / (gli - 63) : 0;
    o = `<div class="dose-table">${line('HOMA-IR', f(ir,2), ir > 2.7 ? 'var(--orange)' : 'var(--green)')}${line('HOMA-β', beta ? `${f(beta,0)}<span class="dose-unit"> %</span>` : '—')}</div>`
      + note('HOMA-IR &gt;2,7 sugere resistência insulínica (corte BRAMS, adulto brasileiro; varia por população e laboratório).');
  } else o = note('Informe glicemia e insulina de jejum.');
  document.getElementById('lab-homa-out').innerHTML = o;
}

/* autoteste: abrir com ?teste e olhar o console */
if (location.search.includes('teste')) {
  document.getElementById('weight').value = 70; document.getElementById('height').value = 170; setSex('M');
  const t = id => document.getElementById(id).textContent, ok = (c, m) => console.assert(c, 'FALHOU: ' + m);
  ok(t('tab-al').includes('Bolus: 105 ml'), 'Intralipid 70kg = 105 ml');
  ok(t('tab-iot').includes(f(wByType('IBW')*16/100) + ' ml= ' + f(wByType('IBW')*16) + ' mg'), 'Sugamadex 16mg/kg em 100mg/ml');
  ok(t('tab-sed').includes('1Sedação leve7') && t('tab-iot').includes('Infusão → aba Sedação'), 'Cetamina 1mg/kg/h = 7 ml/h só na aba Sedação');
  ok(calcLBW(170, 160, 'F') > calcLBW(120, 160, 'F'), 'LBW cresce com o peso');
  ok(wByType('IBW') <= 70 && wByType('LBW') <= 70, 'nunca acima do peso real');
  weights.tbw = 45; ok(wByType('IBW') === 45, 'magro usa peso real'); update();
  ok(Math.round(ckdEpi(1.0, 50, 'M')) === 92, 'CKD-EPI 2021: 50a ♂ Cr 1,0 = 92');
  ok(Math.round(cockcroft(1.0, 40, 70, 'M')) === 97, 'Cockcroft-Gault: 40a ♂ 70kg Cr 1,0 = 97');
  ok(hbRef(60, 'M')[2] === 9.0 && hbRef(30*365, 'F')[2] === 12.0, 'Hb mínima: 2 meses 9,0 · adulta 12,0');
  console.log('autoteste concluído');
}

if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js');
}
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
</body>
</html>
